# EmailJS (https://www.emailjs.com) — used by components/contact-section.tsx
# to send contact form submissions to uitdevs9@gmail.com from the browser.
# Create a service + template in the EmailJS dashboard, then fill these in.
# These are public/browser-exposed values by design (EmailJS public key), so
# NEXT_PUBLIC_ prefixes are required.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
